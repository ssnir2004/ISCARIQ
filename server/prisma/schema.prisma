generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------- Org reference data ----------

model Branch {
  id      String @id @default(cuid())
  name    String @unique
  rfqs    Rfq[]
}

model Department {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  teams Team[]
}

model Team {
  id           String     @id @default(cuid())
  code         String     @unique
  description  String
  isManager    Boolean    @default(false)
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  projects     Project[]
}

// ---------- Customer plants map ----------
// Pins on the interactive Schaeffler plants map, placed by clicking on either
// the world or the Germany-zoom canvas. x/y are percentage coordinates
// (0-100) within that canvas, not real geographic coordinates.

enum PlantMapView {
  WORLD
  GERMANY
}

model Plant {
  id          String       @id @default(cuid())
  name        String       @unique
  regionCode  String?
  specialties String?
  mapView     PlantMapView
  x           Float
  y           Float
  // Offset (in the same percentage units as x/y) of the name label from the
  // pin, so a label can be dragged clear of the map without moving the pin
  // itself. (0, 0) means "not customized yet" — render just below the pin.
  labelDx     Float        @default(0)
  labelDy     Float        @default(0)
  // Marked true for a plant whose existence/details the user isn't sure
  // about, so it can be highlighted differently on the map.
  uncertain   Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

// ---------- RFQ -> Project -> Order -> Production pipeline ----------

enum RfqStatus {
  NEW
  UNDER_REVIEW
  SOLUTION_PROPOSED
  DRAWING_SENT
  CUSTOMER_SIGNED
  REJECTED
  CLOSED
}

model Rfq {
  id                  String    @id @default(cuid())
  rfqNumber           String    @unique
  branch              Branch    @relation(fields: [branchId], references: [id])
  branchId            String
  customer            String    @default("Schaeffler")
  title               String
  materialDescription String?
  problemDescription  String?
  rfqDate             DateTime  @default(now())
  contactPerson       String?
  status              RfqStatus @default(NEW)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  projects            Project[]
}

enum ProjectStatus {
  ASSIGNED
  IN_PROGRESS
  DRAWING_READY
  SENT_TO_BRANCH
  CUSTOMER_SIGNED
  PRODUCTION_PACKAGE_IN_PROGRESS
  PRODUCTION_PACKAGE_READY
  CLOSED
}

model Project {
  id              String          @id @default(cuid())
  projectNumber   String          @unique
  rfq             Rfq             @relation(fields: [rfqId], references: [id])
  rfqId           String
  team            Team            @relation(fields: [teamId], references: [id])
  teamId          String
  status          ProjectStatus   @default(ASSIGNED)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  drawings        Drawing[]
  order           Order?
  productionOrder ProductionOrder?
}

model Drawing {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  version   Int
  fileRef   String?
  sentDate  DateTime?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  project            Project   @relation(fields: [projectId], references: [id])
  projectId          String    @unique
  customerSignedDate DateTime?
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())
}

model ProductionOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String   @unique
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

// ---------- Insert Advisor ----------

enum Iso513Group {
  P
  M
  K
  N
  S
  H
}

model Material {
  id             String      @id @default(cuid())
  iso513Group    Iso513Group
  name           String
  description    String?
  commonUse      String?
  keyProperties  String?
  hardness       String?
  // One fixed top-level category per ISO 513 group (seeded with id
  // "iso513-<group>"); every other material is a subcategory of the
  // category with the same iso513Group.
  isCategory     Boolean     @default(false)
  cuttingConditions CuttingCondition[]
  insertMatches     InsertProblemMatch[]
  npas              Npa[]
}

enum CoolantPreference {
  REQUIRED
  OPTIONAL
  AVOID
}

model Insert {
  id                String            @id @default(cuid())
  designation       String            @unique
  item              String?
  shape             String
  size              String
  chipbreaker       String
  grade             String
  coatingType       String?
  substrate         String?
  coolantPreference CoolantPreference @default(OPTIONAL)
  notes             String?
  image             String?
  cuttingConditions CuttingCondition[]
  problemMatches    InsertProblemMatch[]
  testReports       TestReport[]
}

// ---------- Test reports ----------
// Real-world trial records for a specific Insert, with attached documents
// (photos, reports, etc.) documenting how it performed.

model TestReport {
  id          String           @id @default(cuid())
  insert      Insert           @relation(fields: [insertId], references: [id])
  insertId    String
  testNo      String
  testDate    DateTime
  description String?
  result      String
  country     String?
  customer    String?
  performer   String?
  createdAt   DateTime         @default(now())
  files       TestReportFile[]
}

model TestReportFile {
  id           String     @id @default(cuid())
  testReport   TestReport @relation(fields: [testReportId], references: [id])
  testReportId String
  fileName     String
  fileData     String
  description  String?
  fileDate     DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
}

// ---------- Tools (toolholders) ----------

model Tool {
  id             String  @id @default(cuid())
  designation    String  @unique
  item           String?
  tailConnection String
  tailSize       String
  noseConnection String
  noseSize       String
  notes          String?
  image          String?
}

enum OperationType {
  TURNING
  MILLING
  DRILLING
  GROOVING
  THREADING
  BORING
}

enum CoolantUsage {
  REQUIRED
  OPTIONAL
  AVOID
}

model CuttingCondition {
  id            String        @id @default(cuid())
  insert        Insert        @relation(fields: [insertId], references: [id])
  insertId      String
  material      Material      @relation(fields: [materialId], references: [id])
  materialId    String
  operationType OperationType
  apMin         Float?
  apMax         Float?
  vcMin         Float?
  vcMax         Float?
  feedMin       Float?
  feedMax       Float?
  coolant       CoolantUsage  @default(OPTIONAL)
  notes         String?
}

// ---------- NPA (New Product Announcement) catalog ----------
// Mirrors ISCAR's NPA bulletins: a product announcement with a handful of
// fields that are almost always filled in (recommended applications,
// innovation, key advantages, applicable materials) plus a free-form list of
// extra attributes, since not every NPA calls out the same properties.

model Npa {
  id                      String     @id @default(cuid())
  npaNumber               String?
  title                   String
  category                String?
  applicationType         String?
  designation             String?
  publishDate             DateTime?
  recommendedApplications String?
  innovation              String?
  keyAdvantages           String?
  materialsText           String?
  notes                   String?
  image                   String?
  sourceFileName          String?
  sourceFileData          String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  materials               Material[]
  attributes              NpaAttribute[]
}

model NpaAttribute {
  id    String @id @default(cuid())
  npa   Npa    @relation(fields: [npaId], references: [id], onDelete: Cascade)
  npaId String
  label String
  value String
  order Int    @default(0)
}

// ---------- NPA Knowledge Base ----------
// Structured recommendation records distilled from NPA bulletins, used to
// recommend an insert family by application, ISO 513 material group, and
// customer problem/goal (see the rule-based scoring in routes/npaKnowledge.ts).

enum NpaApplicationCategory {
  MILLING
  TURNING
  GROOVING
  PARTING
  DRILLING
  THREADING
  REAMING
  BORING
  OTHER
}

enum NpaAvailability {
  IN_STOCK
  COMING_SOON
  ASK_PRICING
  NOT_SPECIFIED
}

model NpaKnowledgeItem {
  id                  String                 @id @default(cuid())
  npaNumber           String
  title               String
  publicationDate     DateTime?
  productFamily       String
  subFamily           String?
  insertDesignation   String?
  applicationCategory NpaApplicationCategory
  subApplications     String[]
  iso513Groups        Iso513Group[]
  workpieceMaterials  String[]
  innovation          String?
  advantages          String[]
  recommendedUse      String
  bestForConditions   String[]
  avoidWhen           String?
  keySellingMessage   String?
  technicalNotes      String?
  pricingNotes        String?
  availability        NpaAvailability        @default(NOT_SPECIFIED)
  npaFileName         String?
  npaFileData         String?
  imageData           String?
  sourceLink          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

// ---------- Insert parameter glossary ----------
// Free-text reference entries explaining a Shape/Chipbreaker/Grade/Coating
// value used on Insert (matched by name, not a foreign key).

model Shape {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

model Chipbreaker {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

// Machining applications (Milling, Turning, ...), managed on the
// Applications screen and selectable per Grade.
model Application {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
  grades      Grade[]
}

model Grade {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  image        String?
  // Substrate material, e.g. "Carbide", "Cermet", "CBN" (free text).
  substrate    String?
  // Workpiece material groups and applications this grade is intended for
  // (a grade can cover several of each).
  iso513Groups Iso513Group[]
  applications Application[]
}

// Manual Harder (first) -> Tougher (last) ranking of grades within each
// ISO 513 column of the Grades screen. A grade in several groups has an
// independent position in each column. Ids of grades no longer in the
// group are ignored; grades missing from the list go to the bottom.
model GradeColumnOrder {
  iso513Group Iso513Group @id
  gradeIds    String[]
}

model Coating {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

model ProblemTag {
  id       String @id @default(cuid())
  name     String @unique
  matches  InsertProblemMatch[]
}

model InsertProblemMatch {
  id           String      @id @default(cuid())
  insert       Insert      @relation(fields: [insertId], references: [id])
  insertId     String
  problemTag   ProblemTag  @relation(fields: [problemTagId], references: [id])
  problemTagId String
  material     Material?   @relation(fields: [materialId], references: [id])
  materialId   String?
  priority     Int         @default(0)
  notes        String?

  @@unique([insertId, problemTagId, materialId])
}
