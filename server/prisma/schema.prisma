generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run over a direct (non-pooled) connection: they take an
  // advisory lock, which doesn't work reliably through a connection pooler
  // (e.g. Neon's "-pooler" host). Locally both can be the same URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ---------- Org reference data ----------

model Branch {
  id      String @id @default(cuid())
  name    String @unique
  rfqs    Rfq[]
}

model Department {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  teams Team[]
}

model Team {
  id           String     @id @default(cuid())
  code         String     @unique
  description  String
  isManager    Boolean    @default(false)
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  projects     Project[]
}

// ---------- Customer plants map ----------
// Pins on the interactive Schaeffler plants map, placed by clicking on either
// the world or the Germany-zoom canvas. x/y are percentage coordinates
// (0-100) within that canvas, not real geographic coordinates.

enum PlantMapView {
  WORLD
  GERMANY
}

model Plant {
  id          String       @id @default(cuid())
  name        String       @unique
  regionCode  String?
  specialties String?
  mapView     PlantMapView
  x           Float
  y           Float
  // Offset (in the same percentage units as x/y) of the name label from the
  // pin, so a label can be dragged clear of the map without moving the pin
  // itself. (0, 0) means "not customized yet" — render just below the pin.
  labelDx     Float        @default(0)
  labelDy     Float        @default(0)
  // Marked true for a plant whose existence/details the user isn't sure
  // about, so it can be highlighted differently on the map.
  uncertain   Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

// ---------- RFQ -> Project -> Order -> Production pipeline ----------

enum RfqStatus {
  NEW
  UNDER_REVIEW
  SOLUTION_PROPOSED
  DRAWING_SENT
  CUSTOMER_SIGNED
  REJECTED
  CLOSED
}

model Rfq {
  id                  String    @id @default(cuid())
  rfqNumber           String    @unique
  branch              Branch    @relation(fields: [branchId], references: [id])
  branchId            String
  customer            String    @default("Schaeffler")
  title               String
  materialDescription String?
  problemDescription  String?
  rfqDate             DateTime  @default(now())
  contactPerson       String?
  status              RfqStatus @default(NEW)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  projects            Project[]
}

enum ProjectStatus {
  ASSIGNED
  IN_PROGRESS
  DRAWING_READY
  SENT_TO_BRANCH
  CUSTOMER_SIGNED
  PRODUCTION_PACKAGE_IN_PROGRESS
  PRODUCTION_PACKAGE_READY
  CLOSED
}

model Project {
  id              String          @id @default(cuid())
  projectNumber   String          @unique
  rfq             Rfq             @relation(fields: [rfqId], references: [id])
  rfqId           String
  team            Team            @relation(fields: [teamId], references: [id])
  teamId          String
  status          ProjectStatus   @default(ASSIGNED)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  drawings        Drawing[]
  order           Order?
  productionOrder ProductionOrder?
}

model Drawing {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  version   Int
  fileRef   String?
  sentDate  DateTime?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  project            Project   @relation(fields: [projectId], references: [id])
  projectId          String    @unique
  customerSignedDate DateTime?
  status             String    @default("OPEN")
  createdAt          DateTime  @default(now())
}

model ProductionOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String   @unique
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

// ---------- Insert Advisor ----------

enum Iso513Group {
  P
  M
  K
  N
  S
  H
  // Not an ISO 513 group: sintered materials (powder metallurgy), used only
  // by CBN grades.
  SM
}

model Material {
  id             String      @id @default(cuid())
  iso513Group    Iso513Group
  name           String
  description    String?
  commonUse      String?
  keyProperties  String?
  hardness       String?
  // Picture of the material family, viewed from its header on the
  // Materials screen (set on the ISO 513 categories).
  image          String?
  // One fixed top-level category per ISO 513 group (seeded with id
  // "iso513-<group>"); every other material is a subcategory of the
  // category with the same iso513Group.
  isCategory     Boolean     @default(false)
  cuttingConditions CuttingCondition[]
  gradeRecommendations GradeRecommendation[]
  insertMatches     InsertProblemMatch[]
  npas              Npa[]
}

enum CoolantPreference {
  REQUIRED
  OPTIONAL
  AVOID
}

model Insert {
  id                String            @id @default(cuid())
  designation       String            @unique
  item              String?
  shape             String
  size              String
  chipbreaker       String
  grade             String
  coatingType       String?
  substrate         String?
  coolantPreference CoolantPreference @default(OPTIONAL)
  notes             String?
  image             String?
  cuttingConditions CuttingCondition[]
  problemMatches    InsertProblemMatch[]
  testReports       TestReport[]
}

// ---------- Test reports ----------
// Real-world trial records for a specific Insert, with attached documents
// (photos, reports, etc.) documenting how it performed.

model TestReport {
  id          String           @id @default(cuid())
  insert      Insert           @relation(fields: [insertId], references: [id])
  insertId    String
  testNo      String
  testDate    DateTime
  description String?
  result      String
  country     String?
  customer    String?
  performer   String?
  createdAt   DateTime         @default(now())
  files       TestReportFile[]
}

model TestReportFile {
  id           String     @id @default(cuid())
  testReport   TestReport @relation(fields: [testReportId], references: [id])
  testReportId String
  fileName     String
  fileData     String
  description  String?
  fileDate     DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
}

// ---------- Tools (toolholders) ----------

model Tool {
  id             String  @id @default(cuid())
  designation    String  @unique
  item           String?
  tailConnection String
  tailSize       String
  noseConnection String
  noseSize       String
  notes          String?
  image          String?
}

enum OperationType {
  TURNING
  MILLING
  DRILLING
  GROOVING
  THREADING
  BORING
}

enum CoolantUsage {
  REQUIRED
  OPTIONAL
  AVOID
}

model CuttingCondition {
  id            String        @id @default(cuid())
  insert        Insert        @relation(fields: [insertId], references: [id])
  insertId      String
  material      Material      @relation(fields: [materialId], references: [id])
  materialId    String
  operationType OperationType
  apMin         Float?
  apMax         Float?
  vcMin         Float?
  vcMax         Float?
  feedMin       Float?
  feedMax       Float?
  coolant       CoolantUsage  @default(OPTIONAL)
  notes         String?
}

// ---------- NPA (New Product Announcement) catalog ----------
// Mirrors ISCAR's NPA bulletins: a product announcement with a handful of
// fields that are almost always filled in (recommended applications,
// innovation, key advantages, applicable materials) plus a free-form list of
// extra attributes, since not every NPA calls out the same properties.

model Npa {
  id                      String     @id @default(cuid())
  npaNumber               String?
  title                   String
  category                String?
  applicationType         String?
  designation             String?
  publishDate             DateTime?
  recommendedApplications String?
  innovation              String?
  keyAdvantages           String?
  materialsText           String?
  notes                   String?
  image                   String?
  sourceFileName          String?
  sourceFileData          String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  materials               Material[]
  attributes              NpaAttribute[]
}

model NpaAttribute {
  id    String @id @default(cuid())
  npa   Npa    @relation(fields: [npaId], references: [id], onDelete: Cascade)
  npaId String
  label String
  value String
  order Int    @default(0)
}

// ---------- NPA Knowledge Base ----------
// Structured recommendation records distilled from NPA bulletins, used to
// recommend an insert family by application, ISO 513 material group, and
// customer problem/goal (see the rule-based scoring in routes/npaKnowledge.ts).

enum NpaApplicationCategory {
  MILLING
  TURNING
  GROOVING
  PARTING
  DRILLING
  THREADING
  REAMING
  BORING
  OTHER
}

enum NpaAvailability {
  IN_STOCK
  COMING_SOON
  ASK_PRICING
  NOT_SPECIFIED
}

model NpaKnowledgeItem {
  id                  String                 @id @default(cuid())
  npaNumber           String
  title               String
  publicationDate     DateTime?
  productFamily       String
  subFamily           String?
  insertDesignation   String?
  applicationCategory NpaApplicationCategory
  subApplications     String[]
  iso513Groups        Iso513Group[]
  workpieceMaterials  String[]
  innovation          String?
  advantages          String[]
  recommendedUse      String
  bestForConditions   String[]
  avoidWhen           String?
  keySellingMessage   String?
  technicalNotes      String?
  pricingNotes        String?
  availability        NpaAvailability        @default(NOT_SPECIFIED)
  npaFileName         String?
  npaFileData         String?
  imageData           String?
  sourceLink          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

// ---------- Insert parameter glossary ----------
// Free-text reference entries explaining a Shape/Chipbreaker/Grade/Coating
// value used on Insert (matched by name, not a foreign key).

model Shape {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

model Chipbreaker {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

// Machining applications (Milling, Turning, ...), managed on the
// Applications screen and selectable per Grade.
model Application {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  image       String?
  grades      Grade[]
  gradeCases  GradeCase[]
  gradeGroups GradeApplicationGroups[]
  gradeRecommendations GradeRecommendation[]
  toolLines   ToolLine[]
}

// Carbide substrate a grade is built on, managed on the Substrates screen.
// Hardness and fracture toughness (KIC) place it on the substrate map.
model Substrate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
  hardness    Float?
  toughness   Float?
  grades      Grade[]
}

// Grade family, each with its own Grades screen. Existing grades are carbide.
enum GradeFamily {
  CARBIDE
  CBN
  CERAMIC
  PCD
}

model Grade {
  id           String        @id @default(cuid())
  name         String        @unique
  family       GradeFamily   @default(CARBIDE)
  // Optional groups within the family (e.g. "Coated"); each group gets its
  // own chart (a grade in several groups shows in each), and grades without
  // a group share one.
  sets         GradeSet[]
  // What the grade is made of within its family (e.g. ceramic ALUMINA,
  // SiAlON); the Grades map groups grades by it.
  type         GradeType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeId       String?
  // Per-material exceptions to sets (e.g. Coated for K but not for H).
  // Without a row, every material uses all of the grade's sets.
  materialSets GradeMaterialSets[]
  recommendations GradeRecommendation[]
  toolLines    ToolLine[]
  // Competitor grades this grade replaces (e.g. Kennametal KY3500).
  competitors  GradeCompetitor[]
  description  String?
  // Short, important note shown large and bold in the grade's chart block.
  chartNote    String?
  image        String?
  substrate    Substrate?    @relation(fields: [substrateId], references: [id])
  substrateId  String?
  // Workpiece material groups and applications this grade is intended for
  // (a grade can cover several of each).
  iso513Groups Iso513Group[]
  applications Application[]
  chartBoxes   GradeChartBox[]
  cases        GradeCase[]
  // Per-application exceptions to iso513Groups (e.g. S for Turning but not
  // for Milling). Without a row, a grade covers all its groups in every one
  // of its applications.
  applicationGroups GradeApplicationGroups[]
}

// The ISO 513 groups a grade is used for in one specific application, when
// that differs from the grade's full iso513Groups.
// A grade's groups for one of its materials, where they differ from all of
// its groups. setIds are GradeSet ids; ids no longer among the grade's sets
// are ignored.
model GradeMaterialSets {
  grade       Grade       @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId     String
  iso513Group Iso513Group
  setIds      String[]

  @@id([gradeId, iso513Group])
}

model GradeApplicationGroups {
  grade         Grade         @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId       String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  iso513Groups  Iso513Group[]

  @@id([gradeId, applicationId])
}

// A trial / case study for a grade, usually a slide saved as an image (e.g.
// "Milling ISO P (example)"). applicationId / iso513Group narrow it to one
// application and material group; null means it applies to all of them.
model GradeCase {
  id            String       @id @default(cuid())
  grade         Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId       String
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId String?
  iso513Group   Iso513Group?
  title         String
  notes         String?
  image         String
  createdAt     DateTime     @default(now())
}

// Manual Harder (first) -> Tougher (last) ranking of grades within each
// ISO 513 column of the Grades screen. `scope` is "all" for the overall
// board or an Application id for that application's board, so each board
// and column has an independent order. Ids of grades no longer in the
// column are ignored; grades missing from the list go to the bottom.
model GradeColumnOrder {
  scope       String      @default("all")
  iso513Group Iso513Group
  gradeIds    String[]

  @@id([scope, iso513Group])
}

// A grade's box on the Hard (y) / Tough (x) chart of one board (scope "all"
// or an Application id) and ISO 513 group. x/y/w/h are percentages of the
// chart area, measured from its top-left corner; the box spans the grade's
// range. Grades without a box are laid out from the board's ranking.
// A user-defined group of grades within one family (e.g. "Coated" CBN
// grades). On the charts each group has its own chart (board scope suffix
// "~<id>"); grades without a group share the plain one.
model GradeSet {
  id     String      @id @default(cuid())
  name   String
  family GradeFamily
  grades Grade[]

  @@unique([family, name])
}

// A grade's type within one family (e.g. ceramic "ALUMINA"), managed from
// the grade form; one per grade. The Grades map has a box per type.
model GradeType {
  id     String      @id @default(cuid())
  name   String
  family GradeFamily
  grades Grade[]

  @@unique([family, name])
}

// A rule of thumb for choosing grades of one family, shown as a numbered
// list on that family's Grades tab.
model GradeRule {
  id        String      @id @default(cuid())
  family    GradeFamily
  text      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([family, position])
}

// A recommended cutting condition for some grades of one family: work
// material (usually a subcategory, e.g. Gray cast iron), applications,
// rough / semi-finish / finish, cutting speed Vc (m/min: min / recommended /
// max), depth of cut (mm) and feed (mm/rev) ranges, and coolant (dry and/or
// wet). Shown in the Grades "Conditions" view and on
// grade cards.
model GradeRecommendation {
  id           String        @id @default(cuid())
  family       GradeFamily
  material     Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialId   String
  grades       Grade[]
  applications Application[]
  rough        Boolean       @default(false)
  semiFinish   Boolean       @default(false)
  finish       Boolean       @default(false)
  vcMin        Float?
  vcRec        Float?
  vcMax        Float?
  // Depth of cut (mm) and feed (mm/rev) ranges.
  apMin        Float?
  apMax        Float?
  feedMin      Float?
  feedMax      Float?
  dry          Boolean       @default(false)
  wet          Boolean       @default(false)
  notes        String?
  position     Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([family])
}

// A tool family (e.g. the F45SN face mill) suited to some grades in some
// applications. Shown in the Grades "Tools" view of each family its grades
// belong to, and on those grades' cards. Not a catalog item (see Tool).
model ToolLine {
  id               String              @id @default(cuid())
  name             String              @unique
  grades           Grade[]
  applications     Application[]
  // e.g. Face Mill / Shoulder Mill.
  subApplication   ToolSubApplication? @relation(fields: [subApplicationId], references: [id], onDelete: SetNull)
  subApplicationId String?
  // The insert it takes, e.g. "SNGN".
  insert           String?
  image            String?
  notes            String?
  createdAt        DateTime            @default(now())
}

// Sub-applications for tool lines (e.g. Face Mill), managed from the tool form.
model ToolSubApplication {
  id        String     @id @default(cuid())
  name      String     @unique
  toolLines ToolLine[]
}

// A competitor's grade that an ISCAR grade replaces, e.g. Sandvik CC6190
// for IS26. Edited in the grade form; searchable on the Grades screen.
model GradeCompetitor {
  id       String @id @default(cuid())
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId  String
  brand    String
  name     String
  position Int    @default(0)

  @@index([gradeId])
}

model GradeChartBox {
  scope       String
  iso513Group Iso513Group
  grade       Grade       @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  gradeId     String
  x           Float
  y           Float
  w           Float
  h           Float
  // Grades merged into one block on the chart share a mergeId and a box.
  mergeId     String?
  // Stacking order when blocks overlap: higher is drawn in front.
  z           Int         @default(0)

  @@id([scope, iso513Group, gradeId])
}

model Coating {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  image       String?
}

model ProblemTag {
  id       String @id @default(cuid())
  name     String @unique
  matches  InsertProblemMatch[]
}

model InsertProblemMatch {
  id           String      @id @default(cuid())
  insert       Insert      @relation(fields: [insertId], references: [id])
  insertId     String
  problemTag   ProblemTag  @relation(fields: [problemTagId], references: [id])
  problemTagId String
  material     Material?   @relation(fields: [materialId], references: [id])
  materialId   String?
  priority     Int         @default(0)
  notes        String?

  @@unique([insertId, problemTagId, materialId])
}
